{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "theme": "auto",
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.env.testing)",
      "Read(//**/.env.preview)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.bak)",
      "Read(//**/.env.backup)",
      "Read(//**/secrets/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.config/google/**)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(cat *secrets/*)",
      "Bash(cat *.ssh/*)",
      "Bash(cat *.config/google/*)",
      "Bash(cat *.claude.json*)",
      "Bash(Get-Content *.env*)",
      "Bash(Get-Content *secrets/*)",
      "Bash(Get-Content *.ssh/*)",
      "Bash(Get-Content *.config/google/*)",
      "Bash(Get-Content *.claude.json*)",
      "Bash(Get-Content *.credentials.json*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content *secrets/*)",
      "PowerShell(Get-Content *.ssh/*)",
      "PowerShell(Get-Content *.config/google/*)",
      "PowerShell(Get-Content *.claude.json*)",
      "PowerShell(Get-Content *.credentials.json*)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(socat *)",
      "Bash(ssh -R *)",
      "Bash(ssh -D *)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item -Recurse *)",
      "Bash(Remove-Item -Recurse -Force *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Remove-Item -Recurse -Force *)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Bash(git push origin develop *)",
      "Bash(git push upstream main *)",
      "Bash(git push upstream master *)",
      "Bash(git push upstream develop *)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api */merges*)",
      "Bash(gh api graphql *updateRef*)",
      "Bash(gh api graphql *createRef*)",
      "Bash(gh api graphql *mergeBranch*)",
      "PowerShell(gh api *git/refs*)",
      "PowerShell(gh api */merges*)",
      "PowerShell(gh api graphql *updateRef*)",
      "PowerShell(gh api graphql *createRef*)",
      "PowerShell(gh api graphql *mergeBranch*)"
    ]
  }
}
